{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "{{ colors.primary.default.hex }}",
      "2": "{{ colors.secondary.default.hex }}",
      "3": "{{ colors.tertiary.default.hex }}",
      "4": "{{ colors.primary_container.default.hex }}",
      "5": "{{ colors.secondary_container.default.hex }}",
      "6": "{{ colors.tertiary_container.default.hex }}"
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "os",
      "keyWidth": 30,
      "keyColor": "{{ colors.primary.default.hex }}"
    },
    {
      "type": "host",
      "keyWidth": 30,
      "keyColor": "{{ colors.primary.default.hex }}"
    },
    {
      "type": "kernel",
      "keyWidth": 30,
      "keyColor": "{{ colors.primary.default.hex }}"
    },
    {
      "type": "uptime",
      "keyWidth": 30,
      "keyColor": "{{ colors.secondary.default.hex }}"
    },
    {
      "type": "packages",
      "keyWidth": 30,
      "keyColor": "{{ colors.secondary.default.hex }}"
    },
    {
      "type": "shell",
      "keyWidth": 30,
      "keyColor": "{{ colors.secondary.default.hex }}"
    },
    {
      "type": "de",
      "keyWidth": 30,
      "keyColor": "{{ colors.tertiary.default.hex }}"
    },
    {
      "type": "wm",
      "keyWidth": 30,
      "keyColor": "{{ colors.tertiary.default.hex }}"
    },
    {
      "type": "cpu",
      "keyWidth": 30,
      "keyColor": "{{ colors.primary.default.hex }}"
    },
    {
      "type": "gpu",
      "keyWidth": 30,
      "keyColor": "{{ colors.primary.default.hex }}"
    },
    {
      "type": "memory",
      "keyWidth": 30,
      "keyColor": "{{ colors.secondary.default.hex }}"
    },
    {
      "type": "disk",
      "keyWidth": 30,
      "keyColor": "{{ colors.secondary.default.hex }}"
    },
    {
      "type": "localip",
      "keyWidth": 30,
      "keyColor": "{{ colors.tertiary.default.hex }}"
    },
    {
      "type": "battery",
      "keyWidth": 30,
      "keyColor": "{{ colors.tertiary.default.hex }}"
    }
  ]
}
