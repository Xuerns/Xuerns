[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '{{ colors.primary.default.hex }}'
gradient_color_2 = '{{ colors.secondary.default.hex }}'
gradient_color_3 = '{{ colors.tertiary.default.hex }}'
gradient_color_4 = '{{ colors.error.default.hex }}'

[smoothing]
noise_reduction = 77
